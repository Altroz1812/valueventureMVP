{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "tanstack-start-lovable"
    },
    "paddle-ocr": {
      "root": "services/paddle-ocr",
      "runtime": "python",
      "entrypoint": "main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/ocr/(.*)",
      "destination": {
        "service": "paddle-ocr",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
